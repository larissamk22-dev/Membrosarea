# Copie este arquivo para .env.local e preencha.
# O .env.local NUNCA vai para o GitHub (veja o .gitignore).

# --- Supabase: Project Settings > API Keys ---
# Estas duas podem ir para o navegador. A anon key é protegida pela RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEUPROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui

# Esta ignora TODAS as travas. Só é usada em rota de API, no servidor.
# Se ela aparecer em arquivo com 'use client', vazou.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-aqui

# Endereço do site (usado no e-mail de definição de senha).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Panda Video (opcional) ---
# Só é preciso se você quiser escolher o vídeo pela biblioteca dentro do
# painel, em vez de colar o link na mão.
# Pegue em: Panda > Configurações > Avançado > "Gerar nova chave API".
# A chave certa é longa e começa com 'panda-'.
# Fica no servidor. Repare que NÃO tem o prefixo NEXT_PUBLIC_.
PANDA_VIDEO_TOKEN=
